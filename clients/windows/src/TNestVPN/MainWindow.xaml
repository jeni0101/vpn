<Window x:Class="TNestVPN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TNest VPN" Height="520" Width="760"
        Background="#F3F7F5" AllowDrop="True" Drop="OnDrop">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="TNest VPN" FontSize="30" FontWeight="SemiBold"/>
            <TextBlock Text="自用双栈安全连接" Foreground="#66736D" Margin="0,4,0,20"/>
        </StackPanel>
        <Border Grid.Row="1" Background="White" CornerRadius="16" Padding="28">
            <StackPanel>
                <TextBlock x:Name="StatusText" Text="未配置" FontSize="22"/>
                <TextBlock x:Name="DetailText" Text="拖入或选择 .conf / .tnestvpn 文件"
                           Foreground="#66736D" Margin="0,8,0,28"/>
                <Button Content="导入配置" Width="140" Height="42" HorizontalAlignment="Left"
                        Click="ImportClick"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <ComboBox x:Name="RegionBox" Width="220" Height="42"
                              DisplayMemberPath="DisplayName" IsEnabled="False"
                              SelectionChanged="RegionSelectionChanged"/>
                    <Button x:Name="LatencyButton" Content="测试延迟" Width="110" Height="42"
                            Margin="10,0,0,0" IsEnabled="False" Click="TestLatencyClick"/>
                </StackPanel>
                <Button x:Name="ConnectButton" Content="连接" Width="140" Height="42"
                        HorizontalAlignment="Left" Margin="0,12,0,0" IsEnabled="False"
                        Click="ConnectClick"/>
                <TextBlock x:Name="UsageText" Text="当前　下载 0 B　上传 0 B" Margin="0,30,0,0"
                           FontSize="17"/>
                <TextBlock x:Name="LocalUsageText" Text="本机今日 0 B / 0 B　本月 0 B / 0 B"
                           Foreground="#66736D" Margin="0,8,0,0"/>
                <TextBlock x:Name="HistoryUsageText"
                           Text="服务器历史：24 小时、7 天、30 天等待同步"
                           TextWrapping="Wrap" Foreground="#66736D" Margin="0,8,0,0"/>
                <TextBlock Text="全局 IPv4/IPv6 路由启用时，隧道异常不会静默直连。"
                           Foreground="#66736D" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
