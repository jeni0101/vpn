[Unit]
Description=TNest VPN regional node synchronization agent
After=network-online.target wg-quick@wg0.service
Wants=network-online.target
Requires=wg-quick@wg0.service

[Service]
Type=simple
User=root
Group=root
UMask=0077
EnvironmentFile=/etc/personal-vpn-node/node.env
ExecStart=/usr/local/bin/personal-vpn-node-agent
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/personal-vpn-node /var/lib/personal-vpn-node /etc/wireguard
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
