# Copy this file with: scripts/vpnctl config init
# Edit config/local.env before running server or backup commands.

# SSH connection to the Singapore server.
SSH_HOST="203.0.113.10"
SSH_USER="ubuntu"
SSH_PORT="22"
SSH_IDENTITY_FILE="/absolute/path/to/ssh-private-key"

# Public WireGuard endpoint. Keep the fixed IPv4 literal to avoid bootstrap DNS.
VPN_ENDPOINT_IPV4="203.0.113.10"
VPN_PORT="51999"
VPN_INTERFACE="wg0"

# Leave empty to detect the single remote default-route interface.
WAN_INTERFACE=""

# Fixed tunnel addressing.
VPN_IPV4_NETWORK="10.66.0.0/24"
VPN_IPV6_NETWORK="fd66:66:66::/64"
VPN_SERVER_IPV4="10.66.0.1/24"
VPN_SERVER_IPV6="fd66:66:66::1/64"

# Public dual-stack resolvers. All client routes are full-tunnel.
VPN_DNS="1.1.1.1, 1.0.0.1, 2606:4700:4700::1111, 2606:4700:4700::1001"
VPN_MTU="1420"
VPN_KEEPALIVE="25"

# Deployment refuses to continue until both safeguards are explicitly confirmed.
CLOUD_FIREWALL_CONFIRMED="no"
CLOUD_RECOVERY_CONFIRMED="no"

# age recipient is used for backup creation. The identity is needed for verify/restore.
AGE_RECIPIENT="age1replace_with_your_public_recipient"
AGE_IDENTITY_FILE="/absolute/path/to/age-identity.txt"
