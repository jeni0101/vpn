TNEST_CONTROL_URL=https://vpn.tnestai.asia
TNEST_NODE_ID=jp-tyo-01
TNEST_NODE_API_TOKEN_FILE=/etc/personal-vpn-node/api.token
TNEST_NODE_CLIENT_CERT=/etc/personal-vpn-node/client.crt
TNEST_NODE_CLIENT_KEY=/etc/personal-vpn-node/client.key
TNEST_WG_PRIVATE_KEY=/etc/wireguard/wg0.key
TNEST_WG_INTERFACE=wg0
TNEST_NODE_POLL_INTERVAL=30s
# Enable only after read-only validation and a tested rollback point.
TNEST_NODE_APPLY_CHANGES=false
